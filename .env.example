# Copy to `.env` and fill in. NEVER commit `.env`.
# Generate a strong password, e.g.: openssl rand -base64 32

# Codefort execution service. The integrated compose stack serves it as
# http://codefort:3000 on the private network; override only for an external
# instance (prefer authenticated HTTPS there).
CODEFORT_URL="http://localhost:3000"
# Shared secret enforced by codefort on POST /v1/run (sent as
# `Authorization: Bearer <token>`). Set the SAME value for both services in
# compose. Generate one, e.g.: openssl rand -base64 32
CODEFORT_TOKEN=""

# Public base URL of the app as opened in the browser (used for CSRF origin
# checks). Default covers direct http://127.0.0.1:3001 access; set your
# public URL here when serving under a domain or TLS proxy.
ORIGIN="http://127.0.0.1:3001"

# Local/dev database URL (used by `bun run dev`, drizzle-kit, etc.).
DATABASE_URL="postgres://user:password@host:port/db-name"

# Compose / production database settings (used by docker-compose.yml).
# POSTGRES_PASSWORD is REQUIRED for compose (no default).
POSTGRES_USER="happyjudge"
POSTGRES_PASSWORD="change-me-to-a-long-random-secret"
POSTGRES_DB="happyjudge"
# Optional: privileged URL used ONLY by the one-shot `migrate` job.
# Prefer a restricted app role for the app itself if your DB is set up that way.
# MIGRATION_DATABASE_URL="postgres://owner:owner-secret@postgres:5432/happyjudge"
